{
  "name": "grid-cartographer",
  "version": "1.0.0",
  "description": "A visual CSS Grid playground — draw layouts by clicking and dragging, get the CSS instantly.",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build:css": "node build.js",
    "lint:js": "eslint js/",
    "lint:css": "stylelint css/",
    "lint:format": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:format"
  },
  "lint-staged": {
    "*.{html,css,js}": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-use-logical": "^2.1.3"
  }
}
